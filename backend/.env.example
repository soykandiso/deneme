# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
PUBLIC_BASE_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://zalba:zalba@localhost:5432/zalba?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3 / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=zalba-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- Secrets (rotate before any non-local deployment) ---
JWT_MOBILE_SECRET=dev-mobile-secret-change-me
JWT_PORTAL_SECRET=dev-portal-secret-change-me
JWT_ADMIN_SECRET=dev-admin-secret-change-me
SESSION_SECRET=dev-session-secret-change-me
IP_HASH_PEPPER=dev-pepper-change-me

# --- Auth lifetimes ---
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Rate limiting ---
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_COMPLAINT_CREATE_PER_HOUR=5
RATE_LIMIT_REPORT_PER_HOUR=10
RATE_LIMIT_SUGGEST_PER_HOUR=5

# --- Observability ---
SENTRY_DSN=
