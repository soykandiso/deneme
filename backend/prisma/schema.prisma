// Zalba complaint platform — Prisma schema
// Source of truth for the database. See docs/DATABASE.md for the human reference.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext]
}

// -----------------------------
// Enums
// -----------------------------

enum ComplaintStatus {
  NEW
  CONTACTED
  RESOLVED
  REMOVED
}

enum ComplaintCategory {
  QUALITY
  BILLING
  DELIVERY
  SUPPORT
  ACCOUNT
  WARRANTY
  MISLEADING
  OTHER
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UploaderRole {
  PUBLIC
  COMPANY
  ADMIN
}

enum AuditActorRole {
  SYSTEM
  COMPANY
  ADMIN
  PUBLIC
}

// -----------------------------
// Core domain
// -----------------------------

model Company {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String   @unique
  name         String
  category     String
  website      String?
  phone        String?
  description  String?
  logoUrl      String?  @map("logo_url")
  contactEmail String?  @map("contact_email")
  address      String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  complaints    Complaint[]
  companyUsers  CompanyUser[]

  @@index([category])
  @@map("companies")
}

model Complaint {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId              String            @map("company_id") @db.Uuid
  title                  String
  body                   String
  contactEmail           String?           @map("contact_email")
  contactPhone           String?           @map("contact_phone")
  companyReply           String?           @map("company_reply")
  companyReplyUpdatedAt  DateTime?         @map("company_reply_updated_at") @db.Timestamptz(6)
  status                 ComplaintStatus   @default(NEW)
  complaintCategory      ComplaintCategory @map("complaint_category")
  viewCount              Int               @default(0) @map("view_count")
  isPublished            Boolean           @default(false) @map("is_published")
  isDeleted              Boolean           @default(false) @map("is_deleted")
  deletedAt              DateTime?         @map("deleted_at") @db.Timestamptz(6)
  ipHash                 String?           @map("ip_hash")
  draftTokenHash         String?           @unique @map("draft_token_hash")
  draftExpiresAt         DateTime?         @map("draft_expires_at") @db.Timestamptz(6)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  attachments ComplaintAttachment[]
  updates     ComplaintUpdate[]
  reports     Report[]

  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([isDeleted])
  @@index([isPublished, isDeleted])
  @@map("complaints")
}

model ComplaintAttachment {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaintId      String       @map("complaint_id") @db.Uuid
  storageBackend   String       @default("s3") @map("storage_backend")
  storageKey       String       @map("storage_key")
  originalFilename String       @map("original_filename")
  contentType      String       @map("content_type")
  fileSize         BigInt       @map("file_size")
  sha256           String       @db.Char(64)
  uploadedByRole   UploaderRole @default(PUBLIC) @map("uploaded_by_role")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@unique([complaintId, sha256])
  @@index([complaintId])
  @@map("complaint_attachments")
}

model ComplaintUpdate {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaintId String         @map("complaint_id") @db.Uuid
  actor       AuditActorRole
  actorId     String?        @map("actor_id") @db.Uuid
  note        String
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
  @@map("complaint_updates")
}

model Report {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaintId String   @map("complaint_id") @db.Uuid
  reason      String
  detail      String?
  ipHash      String   @map("ip_hash")
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@unique([complaintId, ipHash])
  @@index([resolvedAt, createdAt])
  @@map("reports")
}

model CompanySuggestion {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  website     String?
  category    String?
  note        String?
  status      SuggestionStatus @default(PENDING)
  adminNote   String?          @map("admin_note")
  ipHash      String           @map("ip_hash")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime?        @map("processed_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@map("company_suggestions")
}

// -----------------------------
// Identity
// -----------------------------

model CompanyUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_users")
}

model AdminUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admin_users")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  audience  String
  userId    String   @map("user_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  ipHash    String?  @map("ip_hash")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, audience])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// -----------------------------
// Audit
// -----------------------------

model AdminAuditLog {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorRole   AuditActorRole @map("actor_role")
  actorId     String?        @map("actor_id") @db.Uuid
  action      String
  targetType  String         @map("target_type")
  targetId    String         @map("target_id")
  payloadJson Json?          @map("payload_json")
  ipHash      String?        @map("ip_hash")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("admin_audit_log")
}
