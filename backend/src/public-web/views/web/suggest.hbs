<h1>Suggest a company</h1>
<p class="muted">Don't see a company you'd like to complain about? Suggest it and our team will review.</p>

<form method="post" action="/suggest" class="form">
  <label>Company name
    <input name="name" minlength="2" maxlength="120" required />
  </label>
  <label>Website (optional)
    <input type="url" name="website" maxlength="300" />
  </label>
  <label>Category (optional)
    <input name="category" maxlength="60" placeholder="telecom, retail, banking…" />
  </label>
  <label>Note (optional)
    <textarea name="note" maxlength="500" rows="3"></textarea>
  </label>
  <button class="btn primary" type="submit">Suggest</button>
</form>
